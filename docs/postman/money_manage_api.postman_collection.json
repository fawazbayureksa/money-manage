    {
      "name": "Email Sync (Gmail)",
      "description": "OAuth2 Gmail integration for auto-importing bank transaction emails.\n\n**Flow:**\n1. Call **Get Auth URL** to get a Google login link\n2. Open the link in a browser — Google will redirect to the callback automatically\n3. Call **Sync Emails** to import transactions\n4. Call **Get Status** to see logs",
      "item": [
        {
          "name": "Get Auth URL",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/email-sync/auth",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "email-sync", "auth"]
            },
            "description": "Returns a Google OAuth2 URL. Open it in a browser to grant Gmail access. After authorisation, Google redirects to the callback endpoint automatically."
          }
        },
        {
          "name": "OAuth Callback (Google redirect — do not call manually)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v2/email-sync/callback?code=AUTH_CODE&state=STATE",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "email-sync", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "AUTH_CODE",
                  "description": "Filled by Google automatically"
                },
                {
                  "key": "state",
                  "value": "STATE",
                  "description": "Filled by Google automatically"
                }
              ]
            },
            "description": "Called automatically by Google after the user grants access. Do not call this manually."
          }
        },
        {
          "name": "Sync Emails",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/email-sync/sync",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "email-sync", "sync"]
            },
            "description": "Scans Gmail for BCA, Permata, and SeaBank transaction emails and imports them as transactions."
          }
        },
        {
          "name": "Get Status & Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/email-sync/status?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "email-sync", "status"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Returns connection status (connected/disconnected) and paginated sync logs."
          }
        },
        {
          "name": "Disconnect Gmail",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/email-sync/disconnect",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "email-sync", "disconnect"]
            },
            "description": "Removes the stored Gmail OAuth token for the current user."
          }
        }
      ]
    }
  ]
